/* Debug readout, top-left. Sizes assume the 1920x1080 reference resolution. */
.hud {
    position: absolute;
    left: 24px;
    top: 24px;
    padding: 12px 18px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.5);
}

.hud-line {
    font-size: 26px;
    color: rgb(240, 240, 240);
}
